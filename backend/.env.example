PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/kyk
# Local Vite + live site (comma-separated CORS origins)
FRONTEND_URL=http://localhost:5173,https://knockyourknowledge.com,https://www.knockyourknowledge.com
# On Hostinger set only the live origins, plus:
# CASHFREE_RETURN_URL=https://knockyourknowledge.com/Checkout?order_id={order_id}

# Cashfree Payment Gateway (UPI, debit card, credit card).
# Dashboard → Developers → API Keys.
# Use sandbox keys locally; set CASHFREE_ENV=production for live.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Optional alias names also supported: CASHFREE_CLIENT_ID / CASHFREE_CLIENT_SECRET
# Local only: path to the .pem from Cashfree public-key.zip
# CASHFREE_PUBLIC_KEY_PATH=./keys/cashfree_public_key.pem
# Hostinger: do NOT set CASHFREE_PUBLIC_KEY_PATH.
# Paste the PEM as ONE LINE, with \n between lines, for example:
# CASHFREE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----

# Admin panel API key (send as header x-admin-key)
ADMIN_API_KEY=kyk-admin-local
