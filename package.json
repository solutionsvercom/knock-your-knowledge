{
  "name": "knock-your-knowledge",
  "private": true,
  "version": "1.0.0",
  "description": "KYK website — Express serves the Vite frontend from backend/public",
  "main": "backend/src/server.js",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "node scripts/ensure-linux-rollup.mjs && npm run build --workspace=frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.0"
  },
  "overrides": {
    "vite": {
      "picomatch": "4.0.4"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "fdir": {
      "picomatch": "4.0.4"
    }
  }
}
