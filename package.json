{
  "name": "knock-your-knowledge",
  "private": true,
  "version": "1.0.0",
  "description": "KYK website — Express serves the Vite frontend from backend/public",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "node scripts/ensure-linux-rollup.mjs && npm run build --workspace=kyk-frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "npm run dev --workspace=kyk-backend",
    "dev:frontend": "npm run dev --workspace=kyk-frontend"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.0"
  }
}
