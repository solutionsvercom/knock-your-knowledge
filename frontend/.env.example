# Leave empty. Same-origin /api works locally (Vite proxy) and on Hostinger
# (Express serves the frontend from backend/public).
VITE_API_BASE_URL=

# Must match backend ADMIN_API_KEY (header x-admin-key)
VITE_ADMIN_API_KEY=kyk-admin-local

# Optional. Live site can also read cloud name from GET /api/cloudinary/status.
VITE_CLOUDINARY_CLOUD_NAME=
